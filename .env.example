# Copy to .env to override. Every value shown is the default; there are no secrets in this project.
# Where the programs connect (the compose file publishes the broker on localhost:9092).
BOOTSTRAP_SERVERS=localhost:9092
# Topic, consumer group and the partition count the design calls for (the health command checks it).
TOPIC=order-events
GROUP_ID=order-history
PARTITIONS=6
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Kafka client timeouts, in milliseconds.
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_BACKOFF_MS=100
